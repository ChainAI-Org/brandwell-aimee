/// BrandWell-specific management models are additive so the fork can continue
/// to merge upstream Rakazo changes without replacing generic core behavior.
model BrandwellAiWorkspace {
  id                     String              @id @default(cuid())
  brandwellCustomerId    String              @unique
  rakazoWorkspaceId      String              @unique
  rakazoWorkspace        Organization        @relation(fields: [rakazoWorkspaceId], references: [id], onDelete: Cascade)
  primaryBotId           String?
  serviceIdentityId      String?
  openRouterCredentialId String?
  subscriptionStatus     String              @default("provisioning")
  plan                   String              @default("aimee")
  brandwellAgencyId      String?
  brandwellClientId      String?
  brandwellContractId    String?
  commercialRevision     BigInt              @default(0)
  commercialStatus       String              @default("pending")
  masterSeats            Int                 @default(1)
  sidekickSeats          Int                 @default(0)
  skillBundleVersion     Int                 @default(1)
  provisioningStatus     String              @default("pending")
  provisioningError      String?
  provisioningMetadata   Json                @default("{}")
  modelPolicyLeaseOwner     String?
  modelPolicyLeaseExpiresAt DateTime?
  timezone               String              @default("UTC")
  primaryContactEmail    String
  retentionEndsAt        DateTime?
  canceledAt             DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  sidekicks              BrandwellSidekick[]

  @@index([subscriptionStatus, provisioningStatus])
  @@index([modelPolicyLeaseExpiresAt])
  @@map("brandwell_ai_workspaces")
}

/// A Sidekick is a licensed teammate inside a managed BrandWell client
/// workspace. It has private app access, a private AI employee, and a
/// dedicated computer and inference key while sharing centrally managed model
/// policy and BrandWell service connections.
model BrandwellSidekick {
  id                     String                            @id @default(cuid())
  brandwellSidekickId    String                            @unique
  aiWorkspaceId          String
  aiWorkspace            BrandwellAiWorkspace              @relation(fields: [aiWorkspaceId], references: [id], onDelete: Cascade)
  workspaceId            String
  workspace              Organization                      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email                  String
  name                   String
  roleTitle              String                            @default("GTM Teammate")
  status                 String                            @default("provisioning")
  userId                 String?
  user                   User?                             @relation(fields: [userId], references: [id], onDelete: SetNull)
  botId                  String?                           @unique
  bot                    Bot?                              @relation(fields: [botId], references: [id], onDelete: SetNull)
  computerId             String?                           @unique
  computer               Computer?                         @relation(fields: [computerId], references: [id], onDelete: SetNull)
  invitationId           String?
  workspaceAccessManaged Boolean                           @default(false)
  skillBundleVersion     Int                               @default(1)
  commercialRevision     BigInt                            @default(0)
  activatedAt            DateTime?
  pausedAt               DateTime?
  canceledAt             DateTime?
  createdAt              DateTime                          @default(now())
  updatedAt              DateTime                          @updatedAt
  modelCredential        BrandwellSidekickModelCredential?
  lifecycleOperations    BrandwellSidekickLifecycleOperation[]

  @@unique([aiWorkspaceId, email])
  @@index([workspaceId, status])
  @@index([userId, status])
  @@map("brandwell_sidekicks")
}

/// Durable provider and computer work for one idempotent Sidekick lifecycle
/// request. A partial unique index in the migration permits only one unfinished
/// operation per Sidekick while retaining completed audit history.
model BrandwellSidekickLifecycleOperation {
  id                  String            @id @default(cuid())
  sidekickId          String
  sidekick            BrandwellSidekick @relation(fields: [sidekickId], references: [id], onDelete: Cascade)
  workspaceId         String
  workspace           Organization      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  idempotencyKey      String            @unique
  action              String
  fromStatus          String
  status              String            @default("running")
  providerStatus      String            @default("pending")
  computerStatus      String            @default("pending")
  externalKeyHash     String?
  computerProviderRef String?
  attempts            Int               @default(1)
  lastError           String?
  auditMetadata       Json              @default("{}")
  result              Json              @default("{}")
  startedAt           DateTime          @default(now())
  completedAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([workspaceId, status])
  @@index([status, updatedAt])
  @@map("brandwell_sidekick_lifecycle_operations")
}

