{$RAKAZO_HOST:app.example.com} {
	encode zstd gzip

	handle /health {
		reverse_proxy api:3100
	}

	handle /ready {
		reverse_proxy api:3100
	}

	handle /api/* {
		reverse_proxy api:3100
	}

	handle /rpc/* {
		reverse_proxy api:3100
	}

	handle /internal/* {
		reverse_proxy api:3100
	}

	handle {
		reverse_proxy web:5173
	}
}

ai.brandwell.ai {
	encode zstd gzip

	handle /health {
		reverse_proxy {$BRANDWELL_PRODUCTION_API_UPSTREAM:brandwell-aimee-production-api-1:3100}
	}

	handle /ready {
		reverse_proxy {$BRANDWELL_PRODUCTION_API_UPSTREAM:brandwell-aimee-production-api-1:3100}
	}

	handle /api/* {
		reverse_proxy {$BRANDWELL_PRODUCTION_API_UPSTREAM:brandwell-aimee-production-api-1:3100}
	}

	handle /rpc/* {
		reverse_proxy {$BRANDWELL_PRODUCTION_API_UPSTREAM:brandwell-aimee-production-api-1:3100}
	}

	handle /internal/* {
		reverse_proxy {$BRANDWELL_PRODUCTION_API_UPSTREAM:brandwell-aimee-production-api-1:3100}
	}

	handle {
		reverse_proxy {$BRANDWELL_PRODUCTION_WEB_UPSTREAM:brandwell-aimee-production-web-1:5173}
	}
}

