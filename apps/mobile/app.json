{
  "expo": {
    "name": "BrandWell's AIMEE",
    "slug": "brandwell-aimee",
    "scheme": "aimee",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/brandwell-aimee-icon.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/brandwell-wordmark.png",
          "resizeMode": "contain",
          "backgroundColor": "#050506"
        }
      ],
      "expo-router",
      "expo-secure-store",
      "expo-audio",
      "expo-localization",
      "@react-native-vector-icons/ionicons",
      "@react-native-vector-icons/material-design-icons",
      [
        "expo-notifications",
        {
          "icon": "./assets/brandwell-notification-icon.png",
          "color": "#ED168C"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AIMEE uses your photo library so you can attach images to a conversation.",
          "cameraPermission": "AIMEE uses the camera so you can attach photos to a conversation.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "./plugins/with-worklets-headers"
    ],
    "ios": {
      "bundleIdentifier": "com.brandwell.aimee",
      "buildNumber": "1",
      "supportsTablet": false,
      "icon": "./assets/brandwell-aimee-icon.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "AIMEE uses the camera so you can attach photos to a conversation.",
        "NSPhotoLibraryUsageDescription": "AIMEE uses your photo library so you can attach images to a conversation."
      }
    },
    "android": {
      "package": "com.brandwell.aimee",
      "icon": "./assets/brandwell-aimee-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brandwell-aimee-icon.png",
        "monochromeImage": "./assets/brandwell-notification-icon.png",
        "backgroundColor": "#101114"
      }
    },
    "web": {
      "favicon": "./assets/brandwell-aimee-icon.png"
    },
    "extra": {
      "router": {},
      "supportsRTL": true,
      "officialApiUrl": "https://ai.brandwell.ai"
    }
  }
}
