---
type Props = {
  href?: string;
};

const { href = "/" } = Astro.props as Props;
---

<a class="brand-lockup" href={href} aria-label="BrandWell AIMEE home">
  <img
    class="brand-lockup__mark"
    src="/icon-192.png"
    width="36"
    height="36"
    alt=""
    aria-hidden="true"
  />
  <span class="brand-lockup__word">AIMEE</span>
</a>
