---
import {
  DEFAULT_LOCALE,
  LOCALE_LABELS,
  LOCALES,
  isLocale,
  localeHomePath,
  type Locale,
} from "../i18n/locales";
import {
  BRANDWELL_PRIVACY_URL,
  BRANDWELL_URL,
  CHANGELOG_URL,
  DOCS_URL,
  GITHUB_URL,
} from "../site";
import Logo from "./Logo.astro";

type Props = {
  locale?: Locale;
  languagesLabel?: string;
  navLabel?: string;
  homeHref?: string;
};

const currentLocale: Locale = isLocale(Astro.currentLocale)
  ? Astro.currentLocale
  : (Astro.props.locale ?? DEFAULT_LOCALE);

const {
  languagesLabel = "Language",
  navLabel = "Footer",
  homeHref = localeHomePath(currentLocale),
} = Astro.props;
---

<footer class="site-footer">
  <div class="site-footer__brand">
    <Logo href={homeHref} />
    <span class="site-footer__legal">
      © 2026 ·
      <a href={BRANDWELL_URL}>BrandWell</a>
      · Apache-2.0
    </span>
  </div>
  <div class="site-footer__nav">
    <nav class="site-footer__languages" aria-label={languagesLabel}>
      {
        LOCALES.map((locale) => (
          <a
            href={localeHomePath(locale)}
            hreflang={locale}
            aria-current={locale === currentLocale ? "page" : undefined}
          >
            {LOCALE_LABELS[locale]}
          </a>
        ))
      }
    </nav>
    <nav class="site-footer__links" aria-label={navLabel}>
      <a href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub</a>
      <a href={DOCS_URL} target="_blank" rel="noreferrer">Docs</a>
      <a href={CHANGELOG_URL} target="_blank" rel="noreferrer">Changelog</a>
      <a href="/about/">About</a>
      <a href="/support/">Support</a>
      <a href={BRANDWELL_PRIVACY_URL}>Privacy</a>
    </nav>
  </div>
</footer>
